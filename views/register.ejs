<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Register</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header>
      <a href="/">Home</a> | <a href="/courses">Courses</a>
      <% if (user) { %>
        | <a href="/dashboard">Dashboard</a> | <a href="/auth/logout">Logout</a>
      <% } else { %>
        | <a href="/auth/login">Login</a> | <a href="/auth/register">Register</a>
      <% } %>
    </header>
    <main>
      <h2>Register</h2>
      <%- include('partials/errors', { errors: errors || [] }) %>
      <form method="post" action="/auth/register">
        <label>Name <input name="name" type="text" value="<%= values.name || '' %>"></label><br>
        <label>Email <input name="email" type="email" required value="<%= values.email || '' %>"></label><br>
        <label>Password <input name="password" type="password" required></label><br>
        <label>Role <select name="role"><option value="student" <%= values.role === 'student' ? 'selected' : '' %>>Student</option><option value="lecturer" <%= values.role === 'lecturer' ? 'selected' : '' %>>Lecturer</option></select></label><br>
        <button>Register</button>
      </form>
    </main>
  </body>
</html>

